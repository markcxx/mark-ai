# ============================================================
#  MarkAI — 环境变量配置
# ============================================================
#  复制此文件为 .env.local 并填入你的 API Key。
#  Base URL 已内置默认值，仅在需要自定义时才填写。
#  MODELS 填逗号分隔的模型 ID，留空则该平台不启用。
# ============================================================

# -------------------- 内置平台 --------------------

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODELS="gemini-2.5-flash,gemini-2.5-pro"
# GEMINI_BASE_URL=""

# OpenAI  (默认 https://api.openai.com/v1)
OPENAI_API_KEY=""
OPENAI_MODELS=""
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Anthropic Messages 原生协议
ANTHROPIC_API_KEY=""
ANTHROPIC_MODELS=""
# ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
# 自定义渠道可设置 <PREFIX>_RUNTIME="anthropic"，也可在 AI_MODEL_CONFIGS 中逐模型设置。
# CommandCode 网关的 Claude 模型会自动使用 /messages；同渠道其他模型继续使用原协议。

# DeepSeek  (默认 https://api.deepseek.com)
DEEPSEEK_API_KEY=""
DEEPSEEK_MODELS=""
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# HuggingFace  (默认 https://api-inference.huggingface.co/v1)
HUGGINGFACE_API_KEY=""
HUGGINGFACE_MODELS=""
# HUGGINGFACE_BASE_URL="https://api-inference.huggingface.co/v1"

# 阿里云百炼  (默认 https://dashscope.aliyuncs.com/compatible-mode/v1)
BAILIAN_API_KEY=""
BAILIAN_MODELS=""
# BAILIAN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# 无问芯穹  (默认 https://cloud.infini-ai.com/maas/v1)
INFINIAI_API_KEY=""
INFINIAI_MODELS=""
# INFINIAI_BASE_URL="https://cloud.infini-ai.com/maas/v1"

# -------------------- 自定义平台 --------------------

# 逗号分隔的自定义供应商名称，每个需配置对应的 API_KEY / BASE_URL / MODELS。
# 以 MARK 开头的供应商（如 MARKGPT、MARKAIDS）会统一归属 MarkAI，
# 相同模型 ID 会随机选择一个渠道发送请求。
#
# 示例:
# AI_PROVIDERS="markgpt,markaids,openrouter,moonshot"
#
# MARKGPT_API_KEY=""
# MARKGPT_BASE_URL="https://your-proxy.example.com/v1"
# MARKGPT_MODELS="gpt-4o,claude-sonnet-4"
#
# MARKAIDS_API_KEY=""
# MARKAIDS_BASE_URL="https://another-proxy.example.com/v1"
# MARKAIDS_MODELS="gpt-4o,deepseek-chat"
#
# OPENROUTER_API_KEY=""
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# OPENROUTER_MODELS="openai/gpt-4.1,anthropic/claude-sonnet-4"
#
# MOONSHOT_API_KEY=""
# MOONSHOT_BASE_URL="https://api.moonshot.cn/v1"
# MOONSHOT_MODELS="moonshot-v1-8k,kimi-k2-0711-preview"
# 同一服务商的 Key 若有不同模型权限，应使用独立渠道，避免逗号 Key 池随机选到无权限的 Key。
# 以下前缀会自动发现，无需加入 AI_PROVIDERS；只填写已验证拥有这些模型权限的 Key。
# 阿里云百炼渠道 Key 1（仅列出已验证有权限的模型）
# MARKBAILIAN_KEY1_API_KEY=""
# MARKBAILIAN_KEY1_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# MARKBAILIAN_KEY1_MODELS="qwen3.7-flash,glm-5.3"
#
# 阿里云百炼渠道 Key 2（按这把 Key 的实际权限独立填写）
# MARKBAILIAN_KEY2_API_KEY=""
# MARKBAILIAN_KEY2_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# MARKBAILIAN_KEY2_MODELS=""
AI_PROVIDERS=""

# 可选：JSON 格式的逐模型配置，支持 apiKeyEnv / baseUrlEnv 引用环境变量。
# AI_MODEL_CONFIGS='[{"provider":"openrouter","id":"openai/gpt-4.1","runtime":"openai-compatible","apiKeyEnv":"OPENROUTER_API_KEY","baseUrlEnv":"OPENROUTER_BASE_URL"}]'
AI_MODEL_CONFIGS=""

# -------------------- Token Plan 专用渠道（2026-10-26） --------------------
# 两把 Key 独立管理，避免不可用的 Key 混入同一个随机线路池。
# *_MODELS 仅放可通过 chat/completions 调用的文本模型。
# *_MODEL_IDS / *_MODEL_ID 和 *_URL 是多模态接入配置记录，当前模型加载器不会把它们加入聊天列表。
# 图片、ASR、实时语音、视频和决策模型仍需各自的原生接口适配；填写这些变量不代表应用已接入。
# 文档：https://help.aliyun.com/zh/model-studio/token-plan-multimodal-gen
# 模型列表：GET https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/models
# 鉴权：Authorization: Bearer 对应渠道的 API_KEY。不要把 Key 放到客户端环境变量中。
# 文本模型 glm-5.3 必须开启思考（enable_thinking=true）；其他文本模型按各自能力处理。

# Token Plan Key 1（先填写 Key，再按实际权限启用）
MARKBAILIAN_TOKENPLAN_KEY1_API_KEY=""
MARKBAILIAN_TOKENPLAN_KEY1_BASE_URL="https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
MARKBAILIAN_TOKENPLAN_KEY1_RUNTIME="openai-compatible"
# 文本生成：POST BASE_URL/chat/completions
MARKBAILIAN_TOKENPLAN_KEY1_MODELS="qwen3.7-max,qwen3.7-plus,qwen3.6-flash,glm-5.2,deepseek-v4-pro,deepseek-v4-flash-0731,qwen3.8-max,deepseek-v4-pro-0813,qwen3.8-flash,deepseek-v4.1-flash,glm-5.3,auto,deepseek-v4.1-flash-1017"
# 图片生成：POST IMAGE_URL；input.messages[].content[].text，parameters.size="1024*1024"；从 output.choices[].message.content[].image 取图片。
MARKBAILIAN_TOKENPLAN_KEY1_IMAGE_MODEL_IDS="wan2.7-image,wan2.7-image-pro,qwen-image-3.0-pro"
MARKBAILIAN_TOKENPLAN_KEY1_IMAGE_URL="https://token-plan.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"
# 语音识别：POST ASR_URL；content=[{type:"input_audio",input_audio:{data:"音频 URL 或 data URI"}}]，parameters 指定 format/sample_rate。
MARKBAILIAN_TOKENPLAN_KEY1_ASR_MODEL_ID="qwen-audio-3.0-asr-flash"
MARKBAILIAN_TOKENPLAN_KEY1_ASR_URL="https://token-plan.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"
# 语音合成：POST TTS_URL；input.text / voice / format / sample_rate；响应为 output.audio.url。
MARKBAILIAN_TOKENPLAN_KEY1_TTS_MODEL_ID="qwen-audio-3.0-tts-plus"
MARKBAILIAN_TOKENPLAN_KEY1_TTS_URL="https://token-plan.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer"
MARKBAILIAN_TOKENPLAN_KEY1_TTS_VOICE="longanhuan_v3.6"
# 实时语音：WebSocket REALTIME_URL；session.update → input_audio_buffer.append / commit → response.create。
MARKBAILIAN_TOKENPLAN_KEY1_REALTIME_MODEL_ID="qwen-audio-3.0-realtime-plus"
MARKBAILIAN_TOKENPLAN_KEY1_REALTIME_URL="wss://token-plan.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime?model=qwen-audio-3.0-realtime-plus"
# 视频生成：POST VIDEO_URL，X-DashScope-Async: enable；input.prompt，parameters.resolution="480P",duration=2；再 GET VIDEO_TASK_URL 轮询。
MARKBAILIAN_TOKENPLAN_KEY1_VIDEO_MODEL_ID="wan3.0-video"
MARKBAILIAN_TOKENPLAN_KEY1_VIDEO_URL="https://token-plan.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis"
MARKBAILIAN_TOKENPLAN_KEY1_VIDEO_TASK_URL="https://token-plan.cn-beijing.maas.aliyuncs.com/api/v1/tasks/{task_id}"
# 决策模型：POST DECISION_URL；model / state / questions，不能用 chat/completions。
MARKBAILIAN_TOKENPLAN_KEY1_DECISION_MODEL_ID="decision-model-preview"
MARKBAILIAN_TOKENPLAN_KEY1_DECISION_URL="https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/systemone"

# Token Plan Key 2（先填写 Key，再按实际权限启用）
MARKBAILIAN_TOKENPLAN_KEY2_API_KEY=""
MARKBAILIAN_TOKENPLAN_KEY2_BASE_URL="https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
MARKBAILIAN_TOKENPLAN_KEY2_RUNTIME="openai-compatible"
# 文本生成：POST BASE_URL/chat/completions
MARKBAILIAN_TOKENPLAN_KEY2_MODELS=""
# 此 Key 的图片、语音、视频接口路径与 Key 1 相同，但尚无调用权限。
# 目录中的额外图片模型 qwen-image-2.0 / qwen-image-2.0-pro 也均返回 403，不要加入启用列表。

# 本地语音朗读切换为 Key 1 时使用下列设置（不要使用图片/对话 BASE_URL）：
# MARKAI_TTS_PROVIDER="markbailian_tokenplan_key1"
# MARKAI_TTS_API_KEY="${MARKBAILIAN_TOKENPLAN_KEY1_API_KEY}"
# MARKAI_TTS_BASE_URL="${MARKBAILIAN_TOKENPLAN_KEY1_TTS_URL}"
# MARKAI_TTS_MODEL="qwen-audio-3.0-tts-plus"
# MARKAI_TTS_VOICE="longanhuan_v3.6"
# -------------------- Token Plan 专用渠道结束 --------------------

# -------------------- 本地开发代理（可选） --------------------

# 仅在 NODE_ENV=development 时用于 OpenAI 兼容模型请求，不影响生产环境直连。
# HTTP_PROXY="http://127.0.0.1:7897"
# HTTPS_PROXY="http://127.0.0.1:7897"
# NO_PROXY="localhost,127.0.0.1"
# 如需临时忽略上述代理变量，可设置为 true。
# MARKAI_DISABLE_ENV_PROXY="false"

# -------------------- 数据库 --------------------

# 存储模式：
#   - 设置 MARKAI_SQLITE_PATH → 本地 SQLite 模式（无需登录）
#   - 设置 DATABASE_URL 且不设 MARKAI_SQLITE_PATH → 云端 PostgreSQL 模式（需要登录）
MARKAI_SQLITE_PATH=".data/markai.sqlite"
# 本地模式附件目录；留空时使用 SQLite 文件同级的 files/ 目录。
# MARKAI_LOCAL_FILES_DIR=".data/files"
# 存储限制直接使用 MB 数字；普通附件不限制数量，只限制单文件与总容量。
# 旧版 MARKAI_MAX_*_BYTES / R2_USER_MAX_*_BYTES 变量仍兼容，但不建议继续使用。
MARKAI_MAX_FILE_MB="30"
MARKAI_MAX_AVATAR_MB="5"
MARKAI_MAX_STORAGE_MB="500"
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# -------------------- 对象存储（云端模式） --------------------

# 云端文件与头像使用 Cloudflare R2。私有桶保存聊天附件，公开桶保存用户头像。
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_PRIVATE_BUCKET=""
# R2_PUBLIC_BUCKET=""
# R2_PUBLIC_BASE_URL="https://files.example.com"
# R2_ENDPOINT=""
# R2_REGION="auto"
# R2_PRESIGNED_URL_EXPIRES="600"

# -------------------- Android 应用更新 --------------------

# 新版 Android 直接读取公开 GitHub Releases API；网络故障时读取对象存储的发布快照。
# 签名及 ANDROID_STORAGE_* / ANDROID_DOWNLOAD_BASE_URL 配置在 GitHub android-release 环境，
# 不需要新增生产后端环境变量。下面仅供旧客户端兼容接口使用，令牌只放服务器。
# MARKAI_ANDROID_RELEASE_REPOSITORY="markcxx/mark-ai"
# MARKAI_ANDROID_GITHUB_TOKEN=""

# -------------------- 认证（云端模式必填） --------------------

# Better Auth 密钥（生产环境必须设置，可用 openssl rand -base64 32 生成）
# AUTH_SECRET=""
# 服务端认证基准地址（生产环境推荐设置，运行时生效，不会固化进构建产物）
# APP_URL="https://ai.example.com"

# 注册策略：open = 开放注册，waitlist = 等候名单，closed = 完全关闭
AUTH_REGISTRATION_MODE=open
# 初始管理员邮箱，多个邮箱使用逗号分隔；等候名单新申请默认通知这些管理员
AUTH_ADMIN_EMAILS=
# 等候名单邀请链接有效期（小时）
WAITLIST_INVITE_TTL_HOURS=72

# 用户自定义模型提供商 API Key 的加密密钥（推荐独立于 AUTH_SECRET）
# 生产环境设置后不要随意更换，否则已保存的 API Key 将无法解密。
# 可用 openssl rand -base64 32 生成；未设置时会回退使用 AUTH_SECRET。
# CREDENTIAL_ENCRYPTION_KEY=""

# 启用的 SSO 提供商（逗号分隔：google,github）
# AUTH_SSO_PROVIDERS=""

# 是否额外发送 Better Auth 邮箱验证链接；验证码注册和候补邀请本身已完成邮箱验证
EMAIL_VERIFICATION_ENABLED=false

# Google OAuth
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# GitHub OAuth
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# -------------------- 邮件服务（SMTP） --------------------

# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""

# -------------------- 功能配置 --------------------

# 自动生成会话标题的模型（格式：provider/modelId，需已配置）
# 示例: MARKAI_CONVERSATION_TITLE_MODEL="deepseek/deepseek-chat"
# 拆分为 MARKBAILIAN_KEY1/KEY2 后，可用 markbailian/qwen3.8-flash 在匹配线路间选择，
# 或用 markbailian_key1/qwen3.8-flash 固定线路；模型 ID 必须存在于对应的 *_MODELS 中。
MARKAI_CONVERSATION_TITLE_MODEL=""

# 消息翻译模型（格式：provider/modelId，需已配置）
# 示例: MARKAI_TRANSLATION_MODEL="markgpt/gpt-5-3"
MARKAI_TRANSLATION_MODEL=""

# 语音合成使用独立凭据；PROVIDER 保留用于切换百炼、Edge TTS 等实现。
MARKAI_TTS_PROVIDER=""
MARKAI_TTS_API_KEY=""
MARKAI_TTS_BASE_URL="https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"
MARKAI_TTS_MODEL="qwen3-tts-flash"
MARKAI_TTS_VOICE="Cherry"
# 多语种内容建议保持 Auto；也可按百炼协议设置 Chinese、English 等。
MARKAI_TTS_LANGUAGE_TYPE="Auto"

# 联网搜索 & 网页阅读
# FIRECRAWL_API_KEY 支持逗号分隔多个 Key；网页阅读优先 Firecrawl，回退 Tavily。
FIRECRAWL_API_KEY=""
TAVILY_API_KEY=""
# Optional: server-only model evaluation and reference pricing data.
# Create an API key at https://artificialanalysis.ai/data-api
# Run npm run models:sync to refresh the bundled public snapshot.
ARTIFICIAL_ANALYSIS_API_KEY=""
